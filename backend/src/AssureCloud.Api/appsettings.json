{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "AssureCloud": "Information"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/assurecloud-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "AssureCloud.Api"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AssureCloud": "Server=sql,1433;Initial Catalog=AssureCloud;User Id=sa;Password=YourStrong!Passw0rd;Encrypt=False;TrustServerCertificate=True;",
    "Redis": "redis:6379,ssl=False,abortConnect=False"
  },
  "Authentication": {
    "Authority": "https://login.microsoftonline.com/",
    "Audience": "https://assurecloud-api"
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "KeyVault": {
    "Enabled": false,
    "Uri": ""
  },
  "Storage": {
    "ConnectionString": "",
    "ContainerName": "assurecloud-evidence"
  },
  "Email": {
    "FromAddress": "noreply@assurecloud.com",
    "FromName": "AssureCloud"
  },
  "RateLimiting": {
    "RequestCountLimit": 100,
    "QueueProcessingOrder": "LongestQueue",
    "QueueLimit": 50,
    "RetryAfterHeaderName": "X-RateLimit-Reset"
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:4200", "https://assurecloud.example.com"]
  }
}
