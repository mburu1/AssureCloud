<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>AssureCloud Domain</AssemblyTitle>
    <Description>Domain layer containing entities, value objects, aggregates, and domain events for AssureCloud</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Ardalis.Specification" Version="9.0.0" />
    <PackageReference Include="System.ComponentModel.DataAnnotations" Version="4.3.0" />
  </ItemGroup>

</Project>
