{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "AssureCloud.Workers"
    }
  },
  "ConnectionStrings": {
    "AssureCloud": "Server=sql,1433;Initial Catalog=AssureCloud;User Id=sa;Password=YourStrong!Passw0rd;Encrypt=False;TrustServerCertificate=True;"
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "Storage": {
    "ConnectionString": "",
    "ContainerName": "assurecloud-evidence"
  },
  "Email": {
    "FromAddress": "noreply@assurecloud.com",
    "FromName": "AssureCloud"
  }
}
