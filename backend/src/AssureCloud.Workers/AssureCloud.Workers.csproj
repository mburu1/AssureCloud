<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>AssureCloud Workers</AssemblyTitle>
    <Description>Background worker services for assessment, notifications, reports, and certification</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssureCloud.Application\AssureCloud.Application.csproj" />
    <ProjectReference Include="..\AssureCloud.Domain\AssureCloud.Domain.csproj" />
    <ProjectReference Include="..\AssureCloud.Infrastructure\AssureCloud.Infrastructure.csproj" />
    <ProjectReference Include="..\AssureCloud.Messaging\AssureCloud.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Polly" />
  </ItemGroup>

</Project>
