<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>AssureCloud Workers</AssemblyTitle>
    <Description>Background worker services for assessment, notifications, reports, and certification</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssureCloud.Application\AssureCloud.Application.csproj" />
    <ProjectReference Include="..\AssureCloud.Domain\AssureCloud.Domain.csproj" />
    <ProjectReference Include="..\AssureCloud.Infrastructure\AssureCloud.Infrastructure.csproj" />
    <ProjectReference Include="..\AssureCloud.Messaging\AssureCloud.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="9.0.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="9.0.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.17.0" />
    <PackageReference Include="Polly" Version="8.3.0" />
  </ItemGroup>

</Project>
