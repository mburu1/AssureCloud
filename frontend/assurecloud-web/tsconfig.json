{
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "skipLibCheck": true,
    "noStrictGenericChecks": false,
    "target": "ES2022",
    "module": "es2015",
    "moduleResolution": "node",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "declaration": false,
    "featureDetection": false,
    "fullSymbols": false,
    "extractLicenses": false,
    "resolutionScope": "module",
    "experimentalDecorators": true,
    "importHelpers": true,
    "sourceMap": true,
    "inlineStyleLanguage": "scss",
    "inlineTemplateLanguage": "html",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitUseStrict": false,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "strict": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "strictTemplates": true,
    "noUncheckedIndexedAccessType": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noFallthroughEnumCase": true,
    "noFloatingPromises": false,
    "noUnsafeAny": false,
    "paths": {
      "@app/*": ["src/app/*"],
      "@core/*": ["src/app/core/*"],
      "@shared/*": ["src/app/shared/*"]
    },
    "types": ["node"]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionInjection": true,
    "strictTemplates": true,
    "strictInputAccessPatterns": true,
    "strictNullInputTypes": true,
    "strictSafeNavigationTypes": true,
    "strictDomLocalId": true,
    "strictDomTemplateGuards": true,
    "strictSafeHtml": true,
    "strictSafeStyle": true,
    "strictSafeScript": true,
    "strictSafeResource": true,
    "skipTemplateCodegen": true,
    "fullCompilation": true,
    "disableTypeScriptVersionWarning": true
  }
}
